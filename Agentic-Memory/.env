# MongoDB Configuration
MONGODB_URI=mongodb://cognivox:cognivox@localhost:27017/cognivox
MONGODB_DB=cognivox

# API Configuration
PORT=8000
LOG_LEVEL=INFO
ENABLE_CORS=TRUE

# GPU Configuration
ENABLE_GPUS=TRUE
GPU_COUNT=1
GPU_MEMORY_LIMIT=5GB
GPU_COOL_DOWN_PERIOD=1.0
GPU_ALLOCATION_TIMEOUT=30.0
GPU_MEMORY_THRESHOLD_MB=500

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
SHOW_ENCODING_PROGRESS=FALSE

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./src/Data/chroma_db