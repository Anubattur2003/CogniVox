# Ollama Configuration
OLLAMA_HOST=http://localhost:11434/nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
TEXT_GENERATION_MODEL=qwen3:4b

# Vector Store
VECTOR_STORE_TYPE=chroma

# Graph Database
GRAPH_DB_TYPE=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Document Processing
USE_LLAMAINDEX=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# GPU Settings
USE_CUDA=true
CUDA_VISIBLE_DEVICES=0
