########################################
# 🔐 SECURITY & ENVIRONMENT SETTINGS
########################################
ENVIRONMENT=development
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8002,http://localhost:8003
ADMIN_API_KEY=admin-api-key-change-in-production
SERVICE_API_KEY=service-api-key-change-in-production
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

########################################
# 🗃️ DATABASES
########################################

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=admin
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:password@localhost:5432/admin

# MongoDB
MONGO_ROOT_USERNAME=cognivox
MONGO_ROOT_PASSWORD=cognivox
MONGO_APP_DATABASE=cognivox
MONGO_APP_USER=cognivox
MONGO_APP_PASSWORD=cognivox
MONGO_PORT=27017
MONGODB_URL=mongodb://cognivox:cognivox@localhost:27017/cognivox

# Neo4j
NEO4J_AUTH=neo4j/password
NEO4J_HOST=localhost
NEO4J_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URL=bolt://neo4j:password@localhost:7687

########################################
# 📊 PGADMIN (PostgreSQL Admin)
########################################
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

########################################
# 🧠 AI/LLM SERVICES
########################################

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_API_URL=http://localhost:11434
GPU_DEVICES=all

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-sonnet-20240229

########################################
# 🧩 INTERNAL SERVICES
########################################

# Backend API
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_API_URL=http://localhost:8000

# Memory Service
MEMORY_HOST=localhost
MEMORY_PORT=8002
MEMORY_API_URL=http://localhost:8002

# Graph RAG Service
GRAPHRAG_HOST=localhost
GRAPHRAG_PORT=8003
GRAPHRAG_API_URL=http://localhost:8003

########################################
# 🌐 FRONTEND
########################################
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

########################################
# ⚙️ DOCKER COMPOSE
########################################
COMPOSE_PROJECT_NAME=agentic-platform
