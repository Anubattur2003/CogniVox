# CogniVox Agentic Platform Environment Configuration
# Generated automatically from credentials.json

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=admin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/admin

# MongoDB Database
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=appdb
MONGO_USERNAME=appuser
MONGO_PASSWORD=apppassword
MONGO_URL=mongodb://appuser:apppassword@localhost:27017/appdb

# Neo4j Graph Database
NEO4J_HOST=localhost
NEO4J_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_URL=bolt://neo4j:password@localhost:7687

# Ollama LLM Service
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_PORT=11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_API_URL=http://localhost:11434

# Backend Service
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Memory Service
MEMORY_HOST=localhost
MEMORY_PORT=8002
MEMORY_URL=http://127.0.0.1:8002

# Graphrag Service
GRAPHRAG_HOST=localhost
GRAPHRAG_PORT=8003
GRAPHRAG_URL=http://127.0.0.1:8003

# Frontend Service
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# API Keys (Replace with your actual keys)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Security Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
SESSION_SECRET=your_session_secret_here_change_in_production
